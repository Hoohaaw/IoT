[
  {
    "id": "tab-iot",
    "type": "tab",
    "label": "IoT Pipeline",
    "disabled": false,
    "info": ""
  },

  {
    "id": "emqx-broker",
    "type": "mqtt-broker",
    "name": "emqx-public",
    "broker": "broker.emqx.io",
    "port": "1883",
    "clientid": "nodered-iot",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },

  {
    "id": "sqlite-db",
    "type": "sqlitedb",
    "db": "iot_data.db",
    "mode": "RWC"
  },

  {
    "id": "ui-group-sensor",
    "type": "ui_group",
    "name": "Sensor Data",
    "tab": "ui-tab-main",
    "order": 1,
    "disp": true,
    "width": "6"
  },

  {
    "id": "ui-group-control",
    "type": "ui_group",
    "name": "Device Control",
    "tab": "ui-tab-main",
    "order": 2,
    "disp": true,
    "width": "6"
  },

  {
    "id": "ui-tab-main",
    "type": "ui_tab",
    "name": "IoT Dashboard",
    "icon": "dashboard",
    "order": 1
  },

  {
    "id": "n-create-table",
    "type": "inject",
    "z": "tab-iot",
    "name": "Create table on start",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "0.5",
    "topic": "",
    "payload": "CREATE TABLE IF NOT EXISTS sensor_readings (id INTEGER PRIMARY KEY AUTOINCREMENT, value REAL NOT NULL, timestamp INTEGER NOT NULL, received_at TEXT NOT NULL)",
    "payloadType": "str",
    "x": 160,
    "y": 60,
    "wires": [["n-sqlite-create"]]
  },

  {
    "id": "n-sqlite-create",
    "type": "sqlite",
    "z": "tab-iot",
    "mydb": "sqlite-db",
    "sqlquery": "msg.payload",
    "sql": "",
    "name": "Create table",
    "x": 420,
    "y": 60,
    "wires": [[]]
  },

  {
    "id": "n-mqtt-in",
    "type": "mqtt in",
    "z": "tab-iot",
    "name": "Sensor data",
    "topic": "lnu/iot/ap224gy/sensor",
    "qos": "0",
    "datatype": "auto",
    "broker": "emqx-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 140,
    "y": 160,
    "wires": [["n-json-parse"]]
  },

  {
    "id": "n-json-parse",
    "type": "json",
    "z": "tab-iot",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 340,
    "y": 160,
    "wires": [["n-sqlite-insert", "n-gauge-temp", "n-chart-live"]]
  },

  {
    "id": "n-sqlite-insert",
    "type": "function",
    "z": "tab-iot",
    "name": "Build INSERT",
    "func": "var v = msg.payload.value;\nvar ts = msg.payload.timestamp;\nvar now = new Date().toISOString();\nmsg.payload = [\n    \"INSERT INTO sensor_readings (value, timestamp, received_at) VALUES (?, ?, ?)\",\n    [v, ts, now]\n];\nreturn msg;",
    "outputs": 1,
    "x": 560,
    "y": 120,
    "wires": [["n-sqlite-write"]]
  },

  {
    "id": "n-sqlite-write",
    "type": "sqlite",
    "z": "tab-iot",
    "mydb": "sqlite-db",
    "sqlquery": "prepared",
    "sql": "",
    "name": "Store reading",
    "x": 760,
    "y": 120,
    "wires": [[]]
  },

  {
    "id": "n-gauge-temp",
    "type": "ui_gauge",
    "z": "tab-iot",
    "name": "Temperature gauge",
    "group": "ui-group-sensor",
    "order": 1,
    "width": 0,
    "height": 0,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value}}",
    "min": "-10",
    "max": "50",
    "colors": ["#00b4d8", "#90e0ef", "#ff6b6b"],
    "seg1": "15",
    "seg2": "30",
    "x": 560,
    "y": 180,
    "wires": []
  },

  {
    "id": "n-chart-live",
    "type": "function",
    "z": "tab-iot",
    "name": "Format for chart",
    "func": "msg.payload = msg.payload.value;\nreturn msg;",
    "outputs": 1,
    "x": 560,
    "y": 220,
    "wires": [["n-chart"]]
  },

  {
    "id": "n-chart",
    "type": "ui_chart",
    "z": "tab-iot",
    "name": "Temperature history",
    "group": "ui-group-sensor",
    "order": 2,
    "width": 0,
    "height": 0,
    "label": "Temperature (°C)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for data...",
    "dot": false,
    "ymin": "",
    "ymax": "",
    "removeOlder": "10",
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#00b4d8"],
    "x": 760,
    "y": 220,
    "wires": [[], []]
  },

  {
    "id": "n-history-inject",
    "type": "inject",
    "z": "tab-iot",
    "name": "Load history on start",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "1.5",
    "topic": "",
    "payload": "SELECT value, timestamp, received_at FROM sensor_readings ORDER BY id DESC LIMIT 100",
    "payloadType": "str",
    "x": 160,
    "y": 320,
    "wires": [["n-sqlite-history"]]
  },

  {
    "id": "n-sqlite-history",
    "type": "sqlite",
    "z": "tab-iot",
    "mydb": "sqlite-db",
    "sqlquery": "msg.payload",
    "sql": "",
    "name": "Query history",
    "x": 400,
    "y": 320,
    "wires": [["n-history-format"]]
  },

  {
    "id": "n-history-format",
    "type": "function",
    "z": "tab-iot",
    "name": "Format history for chart",
    "func": "var rows = msg.payload.reverse();\nvar series = rows.map(function(r) {\n    return { x: new Date(r.received_at).getTime(), y: r.value };\n});\nmsg.payload = [{ series: ['Temperature'], data: [series], labels: [''] }];\nreturn msg;",
    "outputs": 1,
    "x": 620,
    "y": 320,
    "wires": [["n-chart"]]
  },

  {
    "id": "ui-group-wifi",
    "type": "ui_group",
    "name": "WiFi Networks",
    "tab": "ui-tab-main",
    "order": 3,
    "disp": true,
    "width": "12"
  },

  {
    "id": "n-wifi-mqtt-in",
    "type": "mqtt in",
    "z": "tab-iot",
    "name": "WiFi scan",
    "topic": "lnu/iot/ap224gy/wifi",
    "qos": "0",
    "datatype": "auto",
    "broker": "emqx-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 140,
    "y": 580,
    "wires": [["n-wifi-json"]]
  },

  {
    "id": "n-wifi-json",
    "type": "json",
    "z": "tab-iot",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 340,
    "y": 580,
    "wires": [["n-wifi-template"]]
  },

  {
    "id": "n-wifi-template",
    "type": "ui_template",
    "z": "tab-iot",
    "group": "ui-group-wifi",
    "name": "WiFi list",
    "order": 1,
    "width": "12",
    "height": "6",
    "format": "<div style='padding:8px'><div ng-repeat='n in msg.payload.networks | orderBy:\"-rssi\"' style='display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #333'><span>{{n.ssid || \"(hidden)\"}}</span><span>{{n.rssi}} dBm</span></div></div>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 540,
    "y": 580,
    "wires": [[]]
  },

  {
    "id": "n-btn-led-on",
    "type": "ui_button",
    "z": "tab-iot",
    "name": "LED ON",
    "group": "ui-group-control",
    "order": 1,
    "width": 0,
    "height": 0,
    "passthru": false,
    "label": "LED ON",
    "tooltip": "",
    "color": "",
    "bgcolor": "#4caf50",
    "icon": "",
    "payload": "{\"state\":true}",
    "payloadType": "json",
    "topic": "lnu/iot/ap224gy/command/led",
    "topicType": "str",
    "x": 140,
    "y": 440,
    "wires": [["n-mqtt-led"]]
  },

  {
    "id": "n-btn-led-off",
    "type": "ui_button",
    "z": "tab-iot",
    "name": "LED OFF",
    "group": "ui-group-control",
    "order": 2,
    "width": 0,
    "height": 0,
    "passthru": false,
    "label": "LED OFF",
    "tooltip": "",
    "color": "",
    "bgcolor": "#f44336",
    "icon": "",
    "payload": "{\"state\":false}",
    "payloadType": "json",
    "topic": "lnu/iot/ap224gy/command/led",
    "topicType": "str",
    "x": 140,
    "y": 480,
    "wires": [["n-mqtt-led"]]
  },

  {
    "id": "n-mqtt-led",
    "type": "mqtt out",
    "z": "tab-iot",
    "name": "LED command",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "emqx-broker",
    "x": 360,
    "y": 460,
    "wires": []
  }
]
