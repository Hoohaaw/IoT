[
  {
    "id": "tab-iot",
    "type": "tab",
    "label": "IoT Pipeline",
    "disabled": false,
    "info": ""
  },

  {
    "id": "emqx-broker",
    "type": "mqtt-broker",
    "name": "emqx-public",
    "broker": "broker.emqx.io",
    "port": "1883",
    "clientid": "nodered-ap224gy",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },

  {
    "id": "sqlite-db",
    "type": "sqlitedb",
    "db": "iot_data.db",
    "mode": "RWC"
  },

  {
    "id": "ui-group-pico",
    "type": "ui_group",
    "name": "Device Status",
    "tab": "ui-tab-main",
    "order": 1,
    "disp": true,
    "width": "6"
  },

  {
    "id": "ui-group-sensor",
    "type": "ui_group",
    "name": "Sensor Data",
    "tab": "ui-tab-main",
    "order": 2,
    "disp": true,
    "width": "6"
  },

  {
    "id": "ui-group-control",
    "type": "ui_group",
    "name": "Device Control",
    "tab": "ui-tab-main",
    "order": 3,
    "disp": true,
    "width": "6"
  },

  {
    "id": "ui-tab-main",
    "type": "ui_tab",
    "name": "IoT Dashboard",
    "icon": "dashboard",
    "order": 1
  },

  {
    "id": "n-create-table",
    "type": "inject",
    "z": "tab-iot",
    "name": "Create table on start",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "0.5",
    "topic": "",
    "payload": "CREATE TABLE IF NOT EXISTS sensor_readings (id INTEGER PRIMARY KEY AUTOINCREMENT, value REAL NOT NULL, timestamp INTEGER NOT NULL, received_at TEXT NOT NULL)",
    "payloadType": "str",
    "x": 160,
    "y": 60,
    "wires": [["n-sqlite-create"]]
  },

  {
    "id": "n-sqlite-create",
    "type": "sqlite",
    "z": "tab-iot",
    "mydb": "sqlite-db",
    "sqlquery": "msg.payload",
    "sql": "",
    "name": "Create table",
    "x": 420,
    "y": 60,
    "wires": [[]]
  },

  {
    "id": "n-mqtt-in",
    "type": "mqtt in",
    "z": "tab-iot",
    "name": "Sensor data",
    "topic": "lnu/iot/ap224gy/sensor",
    "qos": "0",
    "datatype": "auto",
    "broker": "emqx-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 140,
    "y": 160,
    "wires": [["n-json-parse"]]
  },

  {
    "id": "n-json-parse",
    "type": "json",
    "z": "tab-iot",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 340,
    "y": 160,
    "wires": [["n-sqlite-insert", "n-chart-live", "n-set-lastseen"]]
  },

  {
    "id": "n-sqlite-insert",
    "type": "function",
    "z": "tab-iot",
    "name": "Build INSERT",
    "func": "var v = msg.payload.value;\nvar ts = msg.payload.timestamp;\nvar now = new Date().toISOString();\nmsg.topic = \"INSERT INTO sensor_readings (value, timestamp, received_at) VALUES (?, ?, ?)\";\nmsg.params = [v, ts, now];\nreturn msg;",
    "outputs": 1,
    "x": 560,
    "y": 120,
    "wires": [["n-sqlite-write"]]
  },

  {
    "id": "n-sqlite-write",
    "type": "sqlite",
    "z": "tab-iot",
    "mydb": "sqlite-db",
    "sqlquery": "prepared",
    "sql": "",
    "name": "Store reading",
    "x": 760,
    "y": 120,
    "wires": [[]]
  },

  {
    "id": "n-temp-display",
    "type": "ui_template",
    "z": "tab-iot",
    "group": "ui-group-sensor",
    "name": "Temperature display",
    "order": 1,
    "width": "6",
    "height": "4",
    "format": "<div style='display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:24px;gap:8px'><p style='margin:0;font-size:10px;color:#78716c;letter-spacing:3px;text-transform:uppercase;font-weight:600'>Current Temperature</p><div style='display:flex;align-items:flex-start;gap:4px'><span style='font-size:88px;font-weight:200;color:#f59e0b;line-height:1;font-family:system-ui,sans-serif'>{{msg.payload}}</span><span style='font-size:22px;color:#d97706;margin-top:12px;font-weight:300'>°C</span></div><div style='width:48px;height:1px;background:linear-gradient(90deg,transparent,#f59e0b,transparent);opacity:0.5'></div></div>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 760,
    "y": 180,
    "wires": [[]]
  },

  {
    "id": "n-chart-live",
    "type": "function",
    "z": "tab-iot",
    "name": "Format for chart",
    "func": "msg.payload = msg.payload.value;\nreturn msg;",
    "outputs": 1,
    "x": 560,
    "y": 220,
    "wires": [["n-chart", "n-temp-display"]]
  },

  {
    "id": "n-chart",
    "type": "ui_chart",
    "z": "tab-iot",
    "name": "Temperature history",
    "group": "ui-group-sensor",
    "order": 2,
    "width": 0,
    "height": 0,
    "label": "Temperature (°C)",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "Waiting for data...",
    "dot": true,
    "ymin": "",
    "ymax": "",
    "removeOlder": "10",
    "removeOlderPoints": "",
    "removeOlderUnit": "60",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#f59e0b"],
    "x": 760,
    "y": 220,
    "wires": [[], []]
  },

  {
    "id": "n-history-inject",
    "type": "inject",
    "z": "tab-iot",
    "name": "Load history on start",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": "1.5",
    "topic": "",
    "payload": "SELECT value, timestamp, received_at FROM sensor_readings ORDER BY id DESC LIMIT 10",
    "payloadType": "str",
    "x": 160,
    "y": 320,
    "wires": [["n-sqlite-history"]]
  },

  {
    "id": "n-sqlite-history",
    "type": "sqlite",
    "z": "tab-iot",
    "mydb": "sqlite-db",
    "sqlquery": "msg.payload",
    "sql": "",
    "name": "Query history",
    "x": 400,
    "y": 320,
    "wires": [["n-history-format"]]
  },

  {
    "id": "n-history-format",
    "type": "function",
    "z": "tab-iot",
    "name": "Format history for chart",
    "func": "var rows = msg.payload.reverse();\nvar series = rows.map(function(r) {\n    return { x: new Date(r.received_at).getTime(), y: r.value };\n});\nmsg.payload = [{ series: ['Temperature'], data: [series], labels: [''] }];\nreturn msg;",
    "outputs": 1,
    "x": 620,
    "y": 320,
    "wires": [["n-chart"]]
  },

  {
    "id": "ui-group-wifi",
    "type": "ui_group",
    "name": "WiFi Networks",
    "tab": "ui-tab-main",
    "order": 4,
    "disp": true,
    "width": "12"
  },

  {
    "id": "n-wifi-mqtt-in",
    "type": "mqtt in",
    "z": "tab-iot",
    "name": "WiFi scan",
    "topic": "lnu/iot/ap224gy/wifi",
    "qos": "0",
    "datatype": "auto",
    "broker": "emqx-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 140,
    "y": 580,
    "wires": [["n-wifi-json"]]
  },

  {
    "id": "n-wifi-json",
    "type": "json",
    "z": "tab-iot",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 340,
    "y": 580,
    "wires": [["n-wifi-template"]]
  },

  {
    "id": "n-wifi-template",
    "type": "ui_template",
    "z": "tab-iot",
    "group": "ui-group-wifi",
    "name": "WiFi list",
    "order": 1,
    "width": "12",
    "height": "6",
    "format": "<div style='padding:4px 0'><div ng-if='!msg.payload' style='color:#9ca3af;text-align:center;padding:24px;font-size:13px'>Waiting for scan...</div><div ng-repeat='n in msg.payload.networks | orderBy:\"-rssi\"' style='display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border-bottom:1px solid #f3f4f6'><div style='display:flex;align-items:center;gap:12px'><div style='width:7px;height:7px;border-radius:50%;flex-shrink:0;background:{{n.rssi > -60 ? \"#f59e0b\" : n.rssi > -75 ? \"#d97706\" : \"#78350f\"}}'></div><span style='color:#1f2937;font-size:13px'>{{n.ssid || \"(hidden)\"}}</span></div><span style='color:#9ca3af;font-size:12px;font-family:monospace;letter-spacing:1px'>{{n.rssi}} dBm</span></div></div>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 540,
    "y": 580,
    "wires": [[]]
  },

  {
    "id": "n-css",
    "type": "ui_template",
    "z": "tab-iot",
    "group": "",
    "name": "Global CSS",
    "order": 0,
    "width": "0",
    "height": "0",
    "format": "<style>md-ink-bar{background-color:#f59e0b !important;color:#f59e0b !important}md-tabs .md-tab.md-active{color:#f59e0b !important}.nr-dashboard .md-button{border-radius:8px !important;font-size:12px !important;letter-spacing:1px !important;font-weight:600 !important}</style>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "global",
    "x": 140,
    "y": 540,
    "wires": [[]]
  },

  {
    "id": "n-set-lastseen",
    "type": "function",
    "z": "tab-iot",
    "name": "Track last seen",
    "func": "flow.set('picoLastSeen', Date.now());\nreturn null;",
    "outputs": 1,
    "x": 560,
    "y": 700,
    "wires": [[]]
  },

  {
    "id": "n-pico-poll",
    "type": "inject",
    "z": "tab-iot",
    "name": "Check Pico status",
    "props": [{"p": "payload"}],
    "repeat": "15",
    "crontab": "",
    "once": true,
    "onceDelay": "2",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 160,
    "y": 740,
    "wires": [["n-pico-status"]]
  },

  {
    "id": "n-pico-status",
    "type": "function",
    "z": "tab-iot",
    "name": "Pico online check",
    "func": "var lastSeen = flow.get('picoLastSeen') || 0;\nmsg.payload = (Date.now() - lastSeen) < 30000;\nreturn msg;",
    "outputs": 1,
    "x": 370,
    "y": 740,
    "wires": [["n-pico-indicator"]]
  },

  {
    "id": "n-pico-indicator",
    "type": "ui_template",
    "z": "tab-iot",
    "group": "ui-group-pico",
    "name": "Pico status",
    "order": 3,
    "width": 0,
    "height": "2",
    "format": "<div style='display:flex;align-items:center;gap:10px;padding:8px 4px'><div style='width:10px;height:10px;border-radius:50%;background:{{msg.payload ? \"#22c55e\" : \"#ef4444\"}};box-shadow:0 0 6px {{msg.payload ? \"rgba(34,197,94,0.6)\" : \"rgba(239,68,68,0.6)\"}}'></div><span style='font-size:14px;color:#374151'>Pico is: <strong style='color:{{msg.payload ? \"#16a34a\" : \"#dc2626\"}}'>{{msg.payload ? \"Online\" : \"Offline\"}}</strong></span></div>",
    "storeOutMessages": false,
    "fwdInMessages": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "x": 580,
    "y": 740,
    "wires": [[]]
  },

  {
    "id": "n-btn-led-on",
    "type": "ui_button",
    "z": "tab-iot",
    "name": "LED ON",
    "group": "ui-group-control",
    "order": 1,
    "width": 0,
    "height": 0,
    "passthru": false,
    "label": "LED ON",
    "tooltip": "",
    "color": "#fde68a",
    "bgcolor": "#92400e",
    "icon": "",
    "payload": "{\"state\":true}",
    "payloadType": "json",
    "topic": "lnu/iot/ap224gy/command/led",
    "topicType": "str",
    "x": 140,
    "y": 440,
    "wires": [["n-mqtt-led"]]
  },

  {
    "id": "n-btn-led-off",
    "type": "ui_button",
    "z": "tab-iot",
    "name": "LED OFF",
    "group": "ui-group-control",
    "order": 2,
    "width": 0,
    "height": 0,
    "passthru": false,
    "label": "LED OFF",
    "tooltip": "",
    "color": "#6b7280",
    "bgcolor": "#1c1c24",
    "icon": "",
    "payload": "{\"state\":false}",
    "payloadType": "json",
    "topic": "lnu/iot/ap224gy/command/led",
    "topicType": "str",
    "x": 140,
    "y": 480,
    "wires": [["n-mqtt-led"]]
  },

  {
    "id": "n-mqtt-led",
    "type": "mqtt out",
    "z": "tab-iot",
    "name": "LED command",
    "topic": "",
    "qos": "0",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "emqx-broker",
    "x": 360,
    "y": 460,
    "wires": []
  }
]
